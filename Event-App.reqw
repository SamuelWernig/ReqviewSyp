                }
              ]
            }
          ]
        },
        {
          "id": "3",
          "guid": "7e2f089d-80e1-4f1c-8191-902177b79948",
          "heading": "EPIC - Veranstaltungsverwaltung",
          "text": "<p>Umfasst alle Funktionen, die der Verwaltung von Veranstaltungen dienen</p>",
          "history": [
            {
