          "children": [
            {
              "id": "8",
              "guid": "ff5ace59-4b41-4c8f-b2ba-66fc000c4e6d",
              "heading": "Kommende Veranstaltungen auf der Startseite",
              "text": "<p>Als Besucher:in möchte ich auf der Startseite die kommenden Veranstaltungen sehen, damit ich schnell einen Überblick über das Angebot bekomme.</p><p><br></p><p><br></p>",
              "ACCEPTANCE": "<p>- Es werden nur Veranstaltungen in der Zukunft angezeigt, sortiert nach Datum aufsteigend.</p><p>- Die Startseite ist auch ohne Login aufrufbar.</p><p>- Abgesagte Veranstaltungen werden nicht angezeigt oder sind klar als „abgesagt“ gekennzeichnet.</p>",
              "history": [
                {
                  "affectedNodeId": "2",
                  "changedBy": {
                    "company": "HTL Leoben",
                    "email": "m.brandstaetter@edu.htl-leoben.at",
                    "name": "Markus Brandstätter"
                  },
                  "changedOn": "2026-09-23T09:20:59.415Z",
